// use prisma-8

enum PageTextKey {
  @@type("pg/text@1")

  ABOUT_PAGE = "About Page"
  VOWEL_CHART_PAGE = "Vowel Chart Page"
}

model Account {
	id                      String @id
	user                    User @relation(fields: [userId], references: [id])
	userId                  String
	accountId               String
	providerId              String
	accessToken             String?
	refreshToken            String?
	accessTokenExpiresAt    Timestamptz(3)?
	refreshTokenExpiresAt   Timestamptz(3)?
	scope                   String?
	idToken                 String?
	password                String?

	createdAt   DateTime @default(now())
	updatedAt   temporal.updatedAt()

	@@index([userId], map: "account_userId_idx")
	@@map("account")
}

model LanguageLevel {
  id          Int      @id @default(autoincrement())
  name        String
  color       String
  languages   Language[]

  createdAt   DateTime @default(now())
  updatedAt   temporal.updatedAt()

  @@map("languageLevel")
}

model Language {
  id          Int      @id @default(autoincrement())
  name        String
  levelId     Int
  level       LanguageLevel @relation(fields: [levelId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   temporal.updatedAt()

  @@map("language")
}

model PageText {
  id              Int      @id @default(autoincrement())
  key             PageTextKey
  value           String

  createdAt       DateTime @default(now())
  updatedAt       temporal.updatedAt()

  @@map("pageText")
}

model Research {
  id          Int      @id @default(autoincrement())
  year        DateTime
  authors     String[]
  title       String
  publication String
  pageNumbers String?
  filename    String?

  createdAt   DateTime @default(now())
  updatedAt   temporal.updatedAt()

  @@map("research")
}

model Session {
	id          String @id
	user        User @relation(fields: [userId], references: [id])
	userId      String
	token       String @unique
	expiresAt   Timestamptz(3)
	ipAddress   String?
	userAgent   String?

	createdAt   DateTime @default(now())
	updatedAt   temporal.updatedAt()

	@@index([userId], map: "session_userId_idx")
	@@map("session")
}

model Unpublished {
  id       Int      @id @default(autoincrement())
  year     DateTime
  authors  String[]
  title    String
  filename String?

  createdAt   DateTime @default(now())
  updatedAt   temporal.updatedAt()

  @@map("unpublished")
}

model User {
  id              String @id
  name            String
  email           String @unique
  emailVerified   Boolean @default(false)
  image           String?

  createdAt       DateTime @default(now())
  updatedAt       temporal.updatedAt()

  @@map("user")
}

model Verification {
	id          String @id
	identifier  String
	value       String
	expiresAt   Timestamptz(3)

	createdAt   DateTime @default(now())
	updatedAt   temporal.updatedAt()

	@@index([identifier], map: "verification_identifier_idx")
	@@map("verification")
}

model VowelChart {
  id        Int      @id @default(autoincrement())
  name      String
  filename  String

  createdAt   DateTime @default(now())
  updatedAt   temporal.updatedAt()

  @@map("vowelChart")
}

