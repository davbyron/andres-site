// use prisma-8

enum PageTextKey {
  @@type("pg/text@1")

  ABOUT_PAGE = "About Page"
  VOWEL_CHART_PAGE = "Vowel Chart Page"
}

model LanguageLevel {
  id          Int      @id @default(autoincrement())
  name        String
  color       String
  languages   Language[]

  createdAt   DateTime @default(now())
  updatedAt   temporal.updatedAt()

  @@map("languageLevel")
}

model Language {
  id          Int      @id @default(autoincrement())
  name        String
  levelId     Int
  level       LanguageLevel @relation(fields: [levelId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   temporal.updatedAt()

  @@map("language")
}

model PageText {
  id              Int      @id @default(autoincrement())
  key             PageTextKey
  value           String

  createdAt       DateTime @default(now())
  updatedAt       temporal.updatedAt()

  @@map("pageText")
}

model Research {
  id          Int      @id @default(autoincrement())
  year        Int
  authors     String[]
  title       String
  publication String
  pageNumbers String?
  filename    String?

  createdAt   DateTime @default(now())
  updatedAt   temporal.updatedAt()

  @@map("research")
}

model Unpublished {
  id       Int      @id @default(autoincrement())
  year     Int
  authors  String[]
  title    String
  filename String?

  createdAt   DateTime @default(now())
  updatedAt   temporal.updatedAt()

  @@map("unpublished")
}

model VowelChart {
  id        Int      @id @default(autoincrement())
  name      String
  filename  String

  createdAt   DateTime @default(now())
  updatedAt   temporal.updatedAt()

  @@map("vowelChart")
}

